@model IEnumerable<BookRow>

@{
    ViewData["Title"] = "Catalog";
}

<h1>Catalog</h1>
<p><a asp-action="Create">Create New</a></p>

<table class="table">
    <thead>
    <tr><th>Titlu</th><th>Autor</th><th>Comenzi</th></tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr><td>@r.Title</td><td>@r.Author</td><td>@r.Orders</td></tr>
    }
    </tbody>
</table>